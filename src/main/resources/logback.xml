<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%date{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} host=${HOSTNAME:-unknown} service=${JELLY_SERVICE:-jellydb} build=0.1.0 boot=${JELLY_BOOT_ID:-unknown} %-5level %logger{48} %msg%n%ex</pattern></encoder>
  </appender>
  <!-- Preserve emitted lifecycle/error chains; targeted temporary DEBUG is an operator action. -->
  <root level="INFO"><appender-ref ref="STDOUT"/></root>
</configuration>
