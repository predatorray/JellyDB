JELLY_BIND=127.0.0.1
JELLY_PORT=8080
JELLY_DATA_DIR=/var/lib/jellydb
# Set from /proc/sys/kernel/random/boot_id during host installation/startup.
JELLY_BOOT_ID=REPLACE_HOST_BOOT_ID
# Private discovery, never a public browser credential.
JELLY_ZK_CONNECT=10.20.0.11:2181,10.20.0.12:2181,10.20.0.13:2181
JELLY_BOX=jellydb-v1
JELLY_PARTITIONS=8
# Optional authenticated discovery (set both in protected host configuration):
# JELLY_ZK_AUTH_SCHEME=digest
# JELLY_ZK_AUTH_CREDENTIALS=REPLACE
