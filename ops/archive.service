[Unit]
Description=Collect complete local baseline operational journal
After=systemd-journald.service
[Service]
Type=oneshot
User=jellydb
Group=systemd-journal
ExecStart=/opt/jellydb/bin/archive.py collect --unit jellydb.service --unit cluster@zookeeper.service --unit cluster@bookkeeper.service --unit cluster@candybox.service --unit cluster@admin.service --unit caddy.service --unit jellydb-archive.service --unit jellydb-archive-send.service --unit init.scope
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jellydb/archive
