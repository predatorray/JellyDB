[Unit]
Description=JellyDB experimental HTTP service (native managed namespaces)
After=network-online.target cluster@candybox.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
User=jellydb
Group=jellydb
EnvironmentFile=/etc/jellydb/http.env
ExecStart=/opt/jellydb/bin/run.sh
WorkingDirectory=/var/lib/jellydb
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jellydb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jellydb
[Install]
WantedBy=multi-user.target
