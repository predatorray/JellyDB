[Unit]
Description=JellyDB private cluster component %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
User=jellydb
Group=jellydb
EnvironmentFile=/etc/jellydb/%i.env
ExecStart=/opt/jellydb/bin/cluster-component %i
WorkingDirectory=/var/lib/jellydb
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
LimitNOFILE=16384
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jellydb
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
